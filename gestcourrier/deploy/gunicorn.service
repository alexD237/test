# /etc/systemd/system/gestcourrier.service
# Service systemd Gunicorn pour l'API ArchivRH.
# Activation : sudo systemctl enable --now gestcourrier

[Unit]
Description=ArchivRH — API Gunicorn
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=gestcourrier
Group=www-data
WorkingDirectory=/opt/gestcourrier/backend
EnvironmentFile=/opt/gestcourrier/backend/.env
ExecStart=/opt/gestcourrier/backend/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile /var/log/gestcourrier/access.log \
    --error-logfile /var/log/gestcourrier/error.log
Restart=on-failure

[Install]
WantedBy=multi-user.target
